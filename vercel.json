{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/download/android",
      "destination": "/downloads/bhagavad-gita-as-it-is.apk"
    },
    {
      "source": "/download/ios",
      "destination": "/downloads/bhagavad-gita-as-it-is.ipa"
    },
    {
      "source": "/download",
      "destination": "/downloads/bhagavad-gita-as-it-is.apk"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
